<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WhatsApp - Edit Message</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts & Bootstrap Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <!-- External Stylesheet from Public Folder -->
    <link rel="stylesheet" href="/style.css" />
</head>

<body class="d-flex align-items-center justify-content-center py-5">

    <div class="form-card">
        <!-- Card Header -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="form-header-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0 text-white">Edit Message</h4>
                <small class="text-secondary">Update conversation content</small>
            </div>
        </div>

        <!-- Chat Details Info Box -->
        <div class="chat-info-badge mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <span class="sender-badge"><%= chat.sender %></span>
                    <i class="bi bi-arrow-right text-muted mx-1" style="font-size: 0.8rem;"></i>
                    <span class="receiver-badge"><%= chat.receiver %></span>
                </div>
                <span class="badge bg-secondary text-uppercase" style="font-size: 0.65rem;">ID</span>
            </div>
            <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">
                <i class="bi bi-hash me-1"></i><%= chat.id %>
            </small>
        </div>

        <!-- Edit Form -->
        <form action="/chats/<%= chat.id %>?_method=PUT" method="POST">
            <div class="mb-4">
                <label for="message" class="form-label">Message Content</label>
                <textarea id="message" name="message" rows="5" class="form-control" placeholder="Enter your new message..." required><%= chat.message %></textarea>
            </div>

            <!-- Form Actions -->
            <div class="d-flex flex-column gap-2">
                <button type="submit" class="btn-whatsapp justify-content-center py-2 fs-6">
                    <i class="bi bi-check-circle-fill"></i> Confirm Changes
                </button>
                <a href="/chats" class="btn-cancel">Cancel & Go Back</a>
            </div>
        </form>
    </div>
</body>
</html>