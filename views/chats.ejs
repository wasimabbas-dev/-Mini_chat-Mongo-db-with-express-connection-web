<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp - Messages</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts & Bootstrap Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- External Stylesheet -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container py-5 chat-container">
        <!-- Header Section -->
        <div class="header-box d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <!-- Home Button -->
                <a href="/" class="btn btn-whatsapp d-flex align-items-center gap-2">
                    <i class="bi bi-house-door-fill"></i> Home
                </a>

                <!-- Header Title -->
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-whatsapp text-success fs-2 ms-2"></i>
                    <div>
                        <h4 class="mb-0 fw-bold">Chats</h4>
                        <small class="text-muted">Recent conversations</small>
                    </div>
                </div>
            </div>

            <!-- New Chat Button -->
            <a href="/chats/new" class="btn btn-whatsapp d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> New Chat
            </a>
        </div>

        <!-- Chat List -->
        <div class="chat-list">
            <% if (chats.length === 0) { %>
                <div class="chat-info-badge text-center py-5">
                    <i class="bi bi-chat-square-dots text-muted fs-1 mb-3 d-block"></i>
                    <h5 class="text-muted">No messages found</h5>
                    <p class="text-secondary small mb-0">Start a new conversation to see messages here.</p>
                </div>
            <% } else { %>
                <% for (let chat of chats) { %>
                    <div class="card chat-card mb-3 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start gap-3">
                                <!-- Dynamic Avatar -->
                                <div class="avatar">
                                    <%= chat.sender ? chat.sender.charAt(0).toUpperCase() : 'U' %>
                                </div>

                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="text-truncate me-2">
                                            <span class="sender-badge"><%= chat.sender %></span>
                                            <i class="bi bi-arrow-right text-muted mx-1" style="font-size: 0.8rem;"></i>
                                            <span class="receiver-badge"><%= chat.receiver %></span>
                                        </div>
                                        <span class="time-text flex-shrink-0">
                                            <%= new Date(chat.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                        </span>
                                    </div>

                                    <p class="chat-message mb-2 text-break"><%= chat.message %></p>

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="time-text">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            <%= new Date(chat.timestamp).toLocaleDateString() %>
                                        </span>
                                        
                                        <div class="d-flex align-items-center gap-2">
                                            <form method="POST" action="/chats/<%=chat._id%>?_method=DELETE">
                                                <button class="btn btn-whatsapp d-flex align-items-center gap-2">
                                                    Delete Chat
                                                </button>
                                            </form>
                                            <!-- Edit Route Link -->
                                            <a href="/chats/<%= chat._id %>/edit" class="btn btn-sm text-secondary p-0 me-2" title="Edit Message">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <i class="bi bi-check2-all text-info fs-6"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>

</body>
</html>